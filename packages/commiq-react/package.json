{
  "name": "@naikidev/commiq-react",
  "version": "2.0.0",
  "description": "React bindings for Commiq stores: selector, queue, and event hooks built on useSyncExternalStore.",
  "keywords": [
    "commiq",
    "react",
    "hooks",
    "state-management",
    "event-driven",
    "store",
    "usesyncexternalstore"
  ],
  "license": "MIT",
  "author": "Paulius Čepovič",
  "homepage": "https://github.com/NaiKiDEV/commiq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaiKiDEV/commiq.git",
    "directory": "packages/commiq-react"
  },
  "bugs": {
    "url": "https://github.com/NaiKiDEV/commiq/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "@naikidev/commiq": "workspace:^",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@naikidev/commiq": "workspace:^",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
