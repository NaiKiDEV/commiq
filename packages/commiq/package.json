{
  "name": "@naikidev/commiq",
  "version": "2.1.0",
  "description": "Command and event driven state management for JavaScript and TypeScript, with built-in causality tracking.",
  "keywords": [
    "state-management",
    "event-driven",
    "commands",
    "events",
    "store",
    "cqrs",
    "causality",
    "typescript"
  ],
  "license": "MIT",
  "author": "Paulius Čepovič",
  "homepage": "https://github.com/NaiKiDEV/commiq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaiKiDEV/commiq.git",
    "directory": "packages/commiq"
  },
  "bugs": {
    "url": "https://github.com/NaiKiDEV/commiq/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "nanoid": "^5.1.6"
  }
}
